# 高德 Web 服务 API Key，仅用于服务端 POI、路线和天气请求
AMAP_WEB_SERVICE_KEY=

# 公网部署访问保护；不设置密码时保持公开访问
DEMO_ACCESS_USERNAME=nomi
DEMO_ACCESS_PASSWORD=

# 高德 Web 端 JS API Key 与安全密钥，用于浏览器地图渲染
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=

# 行程理解：mock 使用本地规则，minimax 使用服务端大模型
INTENT_PARSER_PROVIDER=mock

# 规划总结：template 使用本地模板，minimax 使用服务端大模型并自动模板兜底
TRIP_NARRATOR_PROVIDER=template

# MiniMax 国内开放平台 OpenAI 兼容接口，仅在服务端读取
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_TIMEOUT_MS=30000

# 仅建议本地开发临时开启；模型解析失败时显式标记并回退规则解析
MINIMAX_ALLOW_MOCK_FALLBACK=false
